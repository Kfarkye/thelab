{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudrun": "npm run build",
    "start": "next start",
    "lint": "eslint",
    "fee-ledger:ddl": "npx tsx scripts/fee-ledger-ddl.ts",
    "research-ledger:ddl": "npx tsx scripts/research-ledger-ddl.ts",
    "margin-ledger:ddl": "npx tsx scripts/margin-ledger-ddl.ts",
    "ringcentral-ledger:ddl": "npx tsx scripts/ringcentral-ledger-ddl.ts",
    "offer-ledger:ddl": "npx tsx scripts/offer-ledger-ddl.ts",
    "portal-templates:seed": "npx tsx src/db/seeds/seed-portal-templates.ts",
    "licensing-chat-log:ddl": "npx tsx scripts/licensing-chat-log-ddl.ts",
    "agent-handoff:ddl": "npx tsx scripts/agent-handoff-ddl.ts",
    "wc:fixtures:ddl": "npx tsx scripts/wc-fixture-ddl.ts",
    "wc:fixtures:sync": "npx tsx scripts/wc-fixture-import.ts",
    "test:tool-policy": "node --test scripts/tests/tool-policy.test.mjs",
    "test:email-template-routing": "node --test scripts/tests/email-template-routing.test.mjs",
    "test:state-normalization": "node --test scripts/tests/state-normalization.test.mjs",
    "test:sports-status": "node --experimental-strip-types --import ./scripts/tests/register-node-ts-resolver.mjs --test scripts/tests/sports-status-normalization.test.ts",
    "test:sports-live-summary": "node --experimental-strip-types --import ./scripts/tests/register-node-ts-resolver.mjs --test scripts/tests/sports-live-summary.test.ts",
    "test:governance-ledger": "node --test scripts/tests/governance-ledger-schema.test.mjs",
    "test:candidate-identity": "node --test scripts/tests/candidate-identity.smoke.test.mjs",
    "test:live-emit-runtime": "node --experimental-strip-types --import ./scripts/tests/register-node-ts-resolver.mjs --test scripts/tests/live-emit-runtime.test.ts",
    "test:live-emit-ws-runtime": "node --experimental-strip-types --import ./scripts/tests/register-node-ts-resolver.mjs --test scripts/tests/live-emit-ws-runtime.test.ts",
    "test:live-emit-gate": "npm run test:live-emit-runtime && npm run test:live-emit-ws-runtime",
    "test:publisher-invariant": "node --test scripts/tests/publisher-invariant.test.mjs",
    "test:ci": "npm run test:tool-policy && npm run test:state-normalization && npm run test:sports-status && npm run test:sports-live-summary && npm run test:governance-ledger && npm run test:repo-indexer && npm run test:live-emit-gate",
    "live-emit:ws": "node --experimental-strip-types --import ./scripts/tests/register-node-ts-resolver.mjs src/live-emit-ws/server.ts",
    "live-emit:ws:deploy": "./scripts/deploy-live-emit-ws.sh",
    "smoke:live-emit-ws": "node ./scripts/smoke-live-emit-ws.mjs",
    "smoke:recruiting-search": "node ./scripts/tests/smoke-recruiting-search.mjs",
    "smoke:recruiting-ask": "node ./scripts/tests/smoke-recruiting-ask.mjs",
    "smoke:recruiter-chat": "node ./scripts/tests/smoke-recruiter-chat.mjs",
    "geocode:hc-candidates": "node ./scripts/tools/geocode-hc-candidates.mjs",
    "geocode:retry-failed": "node ./scripts/tools/retry-failed-geocodes.mjs",
    "check:missing-nova-ids": "node ./scripts/tools/check-missing-nova-ids.mjs",
    "validate:querydata": "node ./scripts/tools/querydata-validate.mjs",
    "check:governance": "npm run test:governance-ledger && node scripts/check-governance.js",
    "test:repo-indexer": "node --experimental-strip-types --import ./scripts/tests/register-node-ts-resolver.mjs --test scripts/tests/repo-indexer.test.ts",
    "test:repo-reindex-integration": "node --experimental-strip-types --import ./scripts/tests/register-node-ts-resolver.mjs --test scripts/tests/repo-reindex.integration.test.ts",
    "sync:repo-discovery": "node --experimental-strip-types --import ./scripts/tests/register-node-ts-resolver.mjs scripts/sync-repo-to-discovery.ts",
    "test:repo-grounding": "node --experimental-strip-types --import ./scripts/tests/register-node-ts-resolver.mjs scripts/test-repo-grounding.ts",
    "deploy:cloudrun:staging": "bash scripts/deploy-cloud-run.sh staging"
  },
  "dependencies": {
    "@anthropic-ai/vertex-sdk": "^0.16.0",
    "@google-cloud/spanner": "^8.6.0",
    "@google-cloud/vision": "^5.3.5",
    "@google/genai": "^1.50.1",
    "@monaco-editor/react": "^4.7.0",
    "@octokit/rest": "^22.0.1",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.6.0",
    "framer-motion": "^12.38.0",
    "google-auth-library": "^10.6.2",
    "ioredis": "^5.6.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "^8.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
